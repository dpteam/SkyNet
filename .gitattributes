# Line endings are normalised to LF in the repository and converted per
# platform on checkout.  Turbo C 2.0 accepts LF-only sources, and keeping
# one canonical form in git is what stops "works on my machine" diffs.
* text=auto eol=lf

# C sources and headers: always LF, so the same bytes build everywhere
*.c    text eol=lf
*.h    text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.svg  text eol=lf

# DOS batch files need CRLF to run under COMMAND.COM
*.bat  text eol=crlf
*.BAT  text eol=crlf
*.cmd  text eol=crlf

# PowerShell is happiest with CRLF on Windows
*.ps1  text eol=crlf

# Binary artefacts: never touch them
*.exe  binary
*.EXE  binary
*.bin  binary
*.BIN  binary
*.pt   binary
*.png  binary
*.jpg  binary
*.7z   binary
*.zip  binary
